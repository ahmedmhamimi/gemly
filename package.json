{
  "name": "gemly",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Gemly for Gemini - Chrome extension (MV3).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "lint": "eslint src tests scripts",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^153.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.13.0"
  }
}
